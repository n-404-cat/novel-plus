<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.java2nb.novel.mapper.FrontEbookMapper">

    <sql id="ebookColumns">
        id,book_name,author_name,isbn,cover_url,file_url,file_format,file_size,intro,author_intro,status,sort,create_time,create_user_id,update_time,update_user_id
    </sql>

    <select id="listDisplayable" resultType="com.java2nb.novel.entity.Ebook">
        select <include refid="ebookColumns"/>
        from ebook
        where status = 1
        <if test="keyword != null and keyword != ''">
            and (
                book_name like concat('%', #{keyword}, '%')
                or author_name like concat('%', #{keyword}, '%')
                or isbn like concat('%', #{keyword}, '%')
                or intro like concat('%', #{keyword}, '%')
            )
        </if>
        order by sort desc, create_time desc, id desc
    </select>

    <select id="getActiveById" resultType="com.java2nb.novel.entity.Ebook">
        select <include refid="ebookColumns"/>
        from ebook
        where status = 1
          and id = #{id}
        limit 1
    </select>
</mapper>

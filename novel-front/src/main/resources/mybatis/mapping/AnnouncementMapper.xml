<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.java2nb.novel.mapper.FrontAnnouncementMapper">

    <sql id="announcementColumns">
        id,title,content,type,status,close_mode,sort,start_time,end_time,create_time,create_user_id,update_time,update_user_id
    </sql>

    <sql id="activeCondition">
        status = 1
        and (start_time is null or start_time &lt;= now())
        and (end_time is null or end_time &gt;= now())
    </sql>

    <select id="listActiveByType" resultType="com.java2nb.novel.entity.Announcement">
        select <include refid="announcementColumns"/>
        from announcement
        where <include refid="activeCondition"/>
          and type = #{type}
        order by sort desc, create_time desc, id desc
        limit #{limit}
    </select>

    <select id="listDisplayable" resultType="com.java2nb.novel.entity.Announcement">
        select <include refid="announcementColumns"/>
        from announcement
        where <include refid="activeCondition"/>
          and type in (1, 2)
        order by sort desc, create_time desc, id desc
    </select>

    <select id="getActiveById" resultType="com.java2nb.novel.entity.Announcement">
        select <include refid="announcementColumns"/>
        from announcement
        where <include refid="activeCondition"/>
          and id = #{id}
        limit 1
    </select>
</mapper>
